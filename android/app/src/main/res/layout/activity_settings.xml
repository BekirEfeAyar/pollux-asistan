<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kagit"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_monogram"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/murekkep"
            android:textSize="15sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_title"
            android:textColor="@color/murekkep"
            android:textSize="17sp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_look"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/themeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_theme"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/themeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_theme_system"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_font"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
            <RadioGroup
                android:id="@+id/fontGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/fontSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/settings_font_small"
                    android:textColor="@color/murekkep" />
                <RadioButton
                    android:id="@+id/fontNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/settings_font_normal"
                    android:textColor="@color/murekkep" />
                <RadioButton
                    android:id="@+id/fontBig"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/settings_font_big"
                    android:textColor="@color/murekkep" />
            </RadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_data"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/builtinInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_data_builtin"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/builtinCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/fullInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_data_full"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/fullStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <ProgressBar
                android:id="@+id/downloadBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/downloadBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/settings_download"
                android:textColor="@color/kiremit" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_voice"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/modelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <Button
                android:id="@+id/modelBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/settings_download"
                android:textColor="@color/kiremit" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_about"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/aboutText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_about_text"
                android:textColor="@color/murekkep"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
