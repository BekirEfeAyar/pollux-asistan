<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kagit"
    android:fitsSystemWindows="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/loginAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_monogram"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/murekkep"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/loginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="Hoş geldin."
            android:textColor="@color/murekkep"
            android:textSize="28sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="Devam etmek için giriş yap."
            android:textColor="@color/soluk"
            android:textSize="17sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Adın"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/nameEdit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field"
            android:hint="Adın"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/murekkep"
            android:textColorHint="@color/soluk"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="E-posta"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/mailEdit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field"
            android:hint="ornek@eposta.com"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/murekkep"
            android:textColorHint="@color/soluk"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Şifre"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/passEdit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_field"
            android:hint="••••"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/murekkep"
            android:textColorHint="@color/soluk"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/passToggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:text="Göster"
            android:textColor="@color/soluk"
            android:textSize="14sp" />
        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_done"
            android:text="Giriş Yap"
            android:textAllCaps="false"
            android:textColor="@color/kagit"
            android:textSize="15sp" />
        <Button
            android:id="@+id/registerBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:text="Hesap Aç"
            android:textAllCaps="false"
            android:textColor="@color/murekkep"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/loginInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/soluk"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
