<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moderatör Paneli"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="64dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@color/gold" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yükleniyor..."
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KULLANICILAR"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <ListView
            android:id="@+id/usersList"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_soft"
            android:divider="@color/line"
            android:dividerHeight="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORULAN SORULAR"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <ListView
            android:id="@+id/questionsList"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_soft"
            android:divider="@color/line"
            android:dividerHeight="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EV BEYNİ (OLLAMA)"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bilgisayarındaki Ollama adresi (örn: http://192.168.1.50:11434). Boş = kapalı."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/ollamaEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/search_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="http://192.168.1.50:11434"
                android:inputType="textUri"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="14sp"
                android:singleLine="true" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ollamaSave"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary_soft"
                android:backgroundTint="@null"
                android:text="Kaydet"
                android:textColor="@color/onGold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
