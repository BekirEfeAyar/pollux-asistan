<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheetWrap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">
    <View
        android:id="@+id/sheetBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/perde" />
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_grab" />
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/avatarBig"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar"
                android:src="@drawable/ic_avatar_default" />
            <ImageButton
                android:id="@+id/avatarCam"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_send_active"
                android:contentDescription="Fotoğraf seç"
                android:padding="9dp"
                android:src="@drawable/ic_camera" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Adın"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field"
            android:hint="Adın"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLength="28"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/murekkep"
            android:textColorHint="@color/soluk"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/photoPick"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:text="Fotoğrafı değiştir"
                android:textAllCaps="false"
                android:textColor="@color/murekkep"
                android:textSize="14sp" />
            <Button
                android:id="@+id/photoClear"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:text="Kaldır"
                android:textAllCaps="false"
                android:textColor="@color/murekkep"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Tema"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/themeSeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_seg"
            android:orientation="horizontal"
            android:padding="4dp">
            <Button
                android:id="@+id/themeSystem"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_seg_sel"
                android:text="Sistem"
                android:textAllCaps="false"
                android:textColor="@color/murekkep"
                android:textSize="14sp" />
            <Button
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Açık"
                android:textAllCaps="false"
                android:textColor="@color/soluk"
                android:textSize="14sp" />
            <Button
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Koyu"
                android:textAllCaps="false"
                android:textColor="@color/soluk"
                android:textSize="14sp" />
        </LinearLayout>
        <Button
            android:id="@+id/sheetDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_done"
            android:text="Tamam"
            android:textAllCaps="false"
            android:textColor="@color/kagit"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/logoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Çıkış yap"
            android:textColor="@color/soluk"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
