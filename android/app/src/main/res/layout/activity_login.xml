<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg"
            app:strokeColor="@color/gold"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/avatar_default" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pollux"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="senin asistanın"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-posta"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/mailEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/search_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="ornek@eposta.com"
            android:inputType="textEmailAddress"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adın"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/nameEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/search_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Adın"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Şifre"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/passToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Göster"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/passEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/search_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="En az 4 karakter"
            android:inputType="textPassword"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp"
            android:singleLine="true" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_primary_soft"
            android:backgroundTint="@null"
            android:text="Giriş Yap"
            android:textColor="@color/onGold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/registerBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_outline"
            android:backgroundTint="@null"
            android:text="Hesap Aç"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
